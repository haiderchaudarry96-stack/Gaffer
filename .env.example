# Copy to .env (gitignored). Never put AWS access keys here:
# on the laptop credentials come from `aws configure` (~/.aws),
# on EC2 from the IAM instance role.

# Named profile from ~/.aws/credentials (leave as "default" unless you created another)
AWS_PROFILE=default
# Overrides aws.region in config.yaml if set
AWS_REGION=ap-southeast-2
# Optional: path to an alternative config file
# GAFFER_CONFIG=config.yaml
